<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WareHouseTZ.View.ComingView"
             Title="Приход товаров">

    <Grid RowDefinitions="Auto,*">

        <!-- Верхняя панель с фильтрами и кнопкой добавления -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="20,10,20,0">

            <!-- Фильтр по датам -->
            <Grid ColumnDefinitions="*,Auto,*" 
                  ColumnSpacing="10"
                  VerticalOptions="Center">

                <DatePicker Grid.Column="0"
                            Date="{Binding SelectedDateFrom}"
                            Format="dd.MM.yyyy"
                            MaximumDate="{Binding SelectedDateTo}"
                            VerticalOptions="Center"/>

                <Label Grid.Column="1"
                       Text="по"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                <DatePicker Grid.Column="2"
                            Date="{Binding SelectedDateTo}"
                            Format="dd.MM.yyyy"
                            MinimumDate="{Binding SelectedDateFrom}"
                            VerticalOptions="Center"/>
            </Grid>

            <!-- SearchBar для поиска -->
            <SearchBar Placeholder="Поиск по товару, поставщику, документу..."
                       Text="{Binding SearchText}"
                       CancelButtonColor="Gray"
                       HorizontalOptions="Fill">
            </SearchBar>

            <!-- Кнопка добавления -->
            <Button Text="➕ Добавить приход" 
                    Command="{Binding AddComingCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"/>
        </VerticalStackLayout>

        <!-- Список приходов -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredComings}"
                        SelectionMode="None"
                        Margin="20,0">

            <!-- Сообщение при пустом списке -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Spacing="20"
                                     Padding="40">

                    <Label Text="📦" 
                           FontSize="50"
                           HorizontalOptions="Center"/>

                    <Label Text="Приходов не найдено" 
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>

                    <Button Text="Добавить приход"
                            Command="{Binding AddComingCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            WidthRequest="200"
                            HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Шаблон каждого прихода -->
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Margin="0,0,0,10"
                            Padding="15"
                            BackgroundColor="White">

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Дата и товар -->
                            <Label Grid.Row="0" 
                                   Grid.Column="0"
                                   Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}" 
                                   FontSize="14"
                                   TextColor="Gray"/>

                            <Label Grid.Row="1" 
                                   Grid.Column="0"
                                   Text="{Binding ProductName}" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#212121"
                                   Margin="0,5,0,0"/>

                            <!-- Количество и цена -->
                            <HorizontalStackLayout Grid.Row="2" 
                                                   Grid.Column="0"
                                                   Spacing="15"
                                                   Margin="0,5,0,0">

                                <Border BackgroundColor="#E8F5E9"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4">
                                    <Label Text="{Binding Quantity, StringFormat='{0} шт.'}" 
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4CAF50"/>
                                </Border>

                                <Border BackgroundColor="#FFF3E0"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4">
                                    <Label Text="{Binding Price, StringFormat='{0:C} за шт.'}" 
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#FF9800"/>
                                </Border>

                                <Border BackgroundColor="#E3F2FD"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4">
                                    <Label Text="{Binding Total, StringFormat='Итого: {0:C}'}" 
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#2196F3"/>
                                </Border>

                            </HorizontalStackLayout>

                            <!-- Поставщик и документ -->
                            <HorizontalStackLayout Grid.Row="3" 
                                                   Grid.Column="0"
                                                   Spacing="10"
                                                   Margin="0,5,0,0">

                                <Label Text="{Binding Supplier}" 
                                       FontSize="12"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"/>

                                <Label Text="•" 
                                       FontSize="12"
                                       TextColor="Gray"/>

                                <Label Text="{Binding Document}" 
                                       FontSize="12"
                                       TextColor="Gray"
                                       FontAttributes="Italic"/>

                            </HorizontalStackLayout>

                            <!-- Кнопки Изменить и Удалить -->
                            <HorizontalStackLayout Grid.RowSpan="4" 
                                                   Grid.Column="1"
                                                   Spacing="10"
                                                   VerticalOptions="Center">

                                <!-- Кнопка Изменить -->
                                <!--<Button Text="✏️" 
                                        FontSize="14"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        CornerRadius="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                         Path=BindingContext.EditComingCommand}"
                                        CommandParameter="{Binding .}"/>-->

                                <!-- Кнопка Удалить -->
                                <Button Text="🗑️" 
                                        FontSize="14"
                                        BackgroundColor="#F44336"
                                        TextColor="White"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        CornerRadius="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                         Path=BindingContext.DeleteComingCommand}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>