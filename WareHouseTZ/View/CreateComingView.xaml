<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WareHouseTZ.View.CreateComingView"
             Title="CreateComingView">

   <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Дата -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Дата прихода" FontSize="14" TextColor="Gray"/>
                    <DatePicker Date="{Binding Date}" Format="dd.MM.yyyy"/>
                </VerticalStackLayout>
            </Border>

            <!-- Товар -->
            <Border Stroke="#E0E0E0"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Товар *" FontSize="12" TextColor="Gray"/>
                    <Picker Title="Выберите товар"
                ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct}"
                ItemDisplayBinding="{Binding Name}"
                            HeightRequest="60"/>
                </VerticalStackLayout>
            </Border>

            <!-- Количество -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Количество *" FontSize="14" TextColor="Gray"/>
                    <Entry Text="{Binding Quantity}" 
                           Keyboard="Numeric" 
                           Placeholder="Введите количество"/>
                </VerticalStackLayout>
            </Border>

            <!-- Цена -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Цена за единицу" FontSize="14" TextColor="Gray"/>
                    <Entry Text="{Binding Price}" 
                           Keyboard="Numeric" 
                           Placeholder="0.00"/>
                </VerticalStackLayout>
            </Border>

            <!-- Поставщик -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Поставщик" FontSize="14" TextColor="Gray"/>
                    <Entry Text="{Binding Supplier}" 
                           Placeholder="Наименование поставщика"/>
                </VerticalStackLayout>
            </Border>

            <!-- Документ -->
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Номер документа" FontSize="14" TextColor="Gray"/>
                    <Entry Text="{Binding Document}" 
                           Placeholder="Номер накладной, счета и т.д."/>
                </VerticalStackLayout>
            </Border>

            <!-- Итого -->
            <Border Stroke="#2196F3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#E3F2FD"
                    Padding="15">
                <HorizontalStackLayout>
                    <Label Text="Итого:" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="Black"/>
                    <Label Text="{Binding Total, StringFormat='{0:C}'}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="Black"
                           Margin="10,0,0,0"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Кнопки -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20">
                <!-- Сохранить -->
                <Button Text="Добавить"
                        Command="{Binding CreateComingCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="8"
                        Grid.Column="1"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>